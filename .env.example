ATLAS_IMAGE_TAG=v0.2.0
ATLAS_WEB_IMAGE_TAG=v0.1.0

PG_REGISTRY=docker.io/library
PG_IMAGE_TAG=16

WEB_BIND_IP=127.0.0.1
WEB_HOST_PORT=8080
ATLAS_BIND_IP=127.0.0.1
ATLAS_HOST_PORT=8081
PG_BIND_IP=127.0.0.1
PG_HOST_PORT=55433

PG_DB=wist_atlas
PG_USER=atlas
PG_PASSWORD=atlas
TZ=Asia/Shanghai
